# Variables de entorno de ejemplo. NO pongas secretos reales aquí.
# Vite solo expone al bundle las variables con prefijo VITE_.
# Recuerda: cualquier VITE_* termina en el JS público del navegador,
# así que NUNCA debe contener secretos (claves de API, tokens, etc.).
# Para esos valores usa un backend; este demo es 100% estático.

VITE_APP_NAME="Portal de Proveedores — Demo"
VITE_CONTACT_EMAIL="contacto@example.com"
